<Window x:Class="SmartStockAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SmartStock AI"
        Width="1360"
        Height="820"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,0,0,24">
                    <TextBlock Text="SmartStock AI"
                               Style="{StaticResource AppTitleTextStyle}" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Шаг 1: shell и базовая навигация"
                               Style="{StaticResource AppSubtitleTextStyle}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="NavigationList"
                             SelectionChanged="NavigationList_OnSelectionChanged"
                             Style="{StaticResource NavigationListStyle}">
                        <ListBoxItem Tag="Dashboard"
                                     Content="Дашборд"
                                     IsSelected="True" />
                        <ListBoxItem Tag="Products"
                                     Content="Товары" />
                        <ListBoxItem Tag="Categories"
                                     Content="Категории" />
                        <ListBoxItem Tag="Suppliers"
                                     Content="Поставщики" />
                        <ListBoxItem Tag="Locations"
                                     Content="Локации" />
                        <ListBoxItem Tag="Inbound"
                                     Content="Приход" />
                        <ListBoxItem Tag="Outbound"
                                     Content="Расход" />
                        <ListBoxItem Tag="Inventory"
                                     Content="Инвентаризация" />
                        <ListBoxItem Tag="Reports"
                                     Content="Отчеты" />
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1"
              Margin="24">
            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden" />
        </Grid>
    </Grid>
</Window>
