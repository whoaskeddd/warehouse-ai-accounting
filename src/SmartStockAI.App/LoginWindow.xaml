<Window x:Class="SmartStockAI.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In"
        Width="560"
        Height="680"
        MinWidth="560"
        MinHeight="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Background="{StaticResource CanvasGradientBrush}">
        <Border Margin="24"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="28"
                Effect="{StaticResource SoftShadowEffect}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="34">
                    <TextBlock
                               Style="{StaticResource SectionEyebrowTextStyle}" ><Run Language="ru-ru" Text="УМНЫЙ СКЛАД ИИ"/></TextBlock>
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource PageTitleTextStyle}" ><Run Language="ru-ru" Text="Вход"/></TextBlock>
                    <TextBlock Margin="0,14,0,0"
                               Text="Войдите в систему как менеджер или оператор склада. Вход для администратора по умолчанию заблокирован."
                               Style="{StaticResource PageDescriptionTextStyle}"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,34,0,0"
                               Style="{StaticResource CardCaptionTextStyle}" ><Run Language="ru-ru" Text="Логин"/></TextBlock>
                    <TextBox x:Name="LoginTextBox"
                             Margin="0,8,0,0"
                             MinHeight="54"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource AppTextBoxStyle}" />

                    <TextBlock Margin="0,18,0,0"
                               Style="{StaticResource CardCaptionTextStyle}" ><Run Language="ru-ru" Text="Пароль"/></TextBlock>
                    <PasswordBox x:Name="PasswordTextBox"
                                 Margin="0,8,0,0"
                                 MinHeight="54"
                                 Style="{StaticResource AppPasswordBoxStyle}" />

                    <Border Margin="0,24,0,0"
                            Padding="18,16"
                            Background="#FFF8FAFD"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <TextBlock Text="Manager: manager / Manager123!&#10;Warehouse operator: operator / Operator123!"
                                   Style="{StaticResource PageDescriptionTextStyle}" />
                    </Border>

                    <TextBlock Margin="0,24,0,0"
                               Text="{Binding ErrorMessage}"
                               Foreground="#FFC05555"
                               TextWrapping="Wrap" />

                    <Grid Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                                Margin="41,-50,40,32"
                                Content="Sign in"
                                Click="SignInButton_OnClick"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
