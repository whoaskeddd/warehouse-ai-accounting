<Page x:Class="SmartStockAI.App.Views.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent"
      Title="Инвентаризация">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
    <Grid Margin="0,0,0,8">
        <Border Style="{StaticResource PageContainerStyle}">
            <StackPanel>
                <TextBlock Text="CONTROL"
                           Style="{StaticResource SectionEyebrowTextStyle}" />
                <TextBlock Margin="0,10,0,0"
                           Text="Инвентаризация"
                           Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Margin="0,8,0,0"
                           Text="Фокус на спокойной пошаговой проверке остатков, расхождениях и завершении без перегрузки деталями."
                           Style="{StaticResource PageDescriptionTextStyle}" />
                <Button Margin="0,18,0,0"
                        HorizontalAlignment="Left"
                        Content="Начать инвентаризацию"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <TextBlock Margin="0,28,0,0"
                           Text="Пустой экран инвентаризации."
                           Style="{StaticResource PlaceholderTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
