<Page x:Class="SmartStockAI.App.Views.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent"
      Title="Инвентаризация">
    <Grid>
        <Border Style="{StaticResource PageContainerStyle}">
            <StackPanel>
                <TextBlock Text="Инвентаризация"
                           Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Margin="0,8,0,0"
                           Text="Заготовка под экран инвентаризации. На шаге 4 сюда подключатся расхождения и завершение инвентаризации."
                           Style="{StaticResource PageDescriptionTextStyle}" />
                <TextBlock Margin="0,28,0,0"
                           Text="Пустой экран инвентаризации."
                           Style="{StaticResource PlaceholderTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
