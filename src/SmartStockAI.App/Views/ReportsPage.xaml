<Page x:Class="SmartStockAI.App.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent"
      Title="Отчеты">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
    <Grid Margin="0,0,0,8">
        <Border Style="{StaticResource PageContainerStyle}">
            <StackPanel>
                    <TextBlock
                           Style="{StaticResource SectionEyebrowTextStyle}" ><Run Language="ru-ru" Text="АНАЛИТИКА"/></TextBlock>
                    <TextBlock Margin="0,10,0,0"
                           Text="Отчеты"
                           Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource PageDescriptionTextStyle}" ><Run Language="ru-ru" Text="Ц"/><Run Text="ентр аналитики с акцентом на табличный preview и понятный экспорт."/></TextBlock>
                    <StackPanel Margin="0,18,0,0"
                            Orientation="Horizontal">
                    <Button Content="Открыть отчеты"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Margin="12,0,0,0"
                            Content="Экспорт"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
                <TextBlock Margin="0,28,0,0"
                           Text="Пустой экран отчетов."
                           Style="{StaticResource PlaceholderTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
