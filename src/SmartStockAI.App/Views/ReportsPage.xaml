<Page x:Class="SmartStockAI.App.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent"
      Title="Отчеты">
    <Grid>
        <Border Style="{StaticResource PageContainerStyle}">
            <StackPanel>
                <TextBlock Text="Отчеты"
                           Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Margin="0,8,0,0"
                           Text="Заготовка под экран отчетов. На шаге 5 сюда подключатся preview, фильтры и экспорт."
                           Style="{StaticResource PageDescriptionTextStyle}" />
                <TextBlock Margin="0,28,0,0"
                           Text="Пустой экран отчетов."
                           Style="{StaticResource PlaceholderTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
