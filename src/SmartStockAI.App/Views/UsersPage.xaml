<Page x:Class="SmartStockAI.App.Views.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent"
      Title="Пользователи">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <Grid Margin="0,0,0,8">
            <Border Style="{StaticResource PageContainerStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                                   Style="{StaticResource SectionEyebrowTextStyle}" ><Run Language="ru-ru" Text="КОНТРОЛЬ ДОСТУПА"/></TextBlock>
                        <TextBlock Margin="0,10,0,0"
                                   Text="Пользователи и роли"
                                   Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource PageDescriptionTextStyle}" ><Run Language="ru-ru" Text="Выбор"/><Run Text=" активного пользователя, базовых ролей и ручного администрирования доступа."/></TextBlock>
                    </StackPanel>

                    <Grid Grid.Row="1"
                          Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PanelCardStyle}"
                                Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Активная сессия"
                                                   Style="{StaticResource CardCaptionTextStyle}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Text="{Binding CurrentUserDisplay}"
                                                   Style="{StaticResource PageTitleTextStyle}"
                                                   FontSize="24" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Обновить"
                                            Click="RefreshButton_OnClick"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>

                                <Grid Grid.Row="1"
                                      Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              Margin="0,0,12,0"
                                              ItemsSource="{Binding Users}"
                                              SelectedItem="{Binding SessionSelectedUser, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource AppComboBoxStyle}" />
                                    <Border Grid.Column="1"
                                            Margin="0,0,12,0"
                                            Padding="14,12"
                                            Background="#FFF8FAFD"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <TextBlock Text="{Binding SessionRoleLabel}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                    </Border>
                                    <Button Grid.Column="2"
                                            Content="Open in editor"
                                            Click="ApplySessionButton_OnClick"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>

                                <Border Grid.Row="2"
                                        Margin="0,22,0,0"
                                        Padding="4"
                                        Background="#FFF8FAFD"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <DataGrid ItemsSource="{Binding Users}"
                                              SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              Style="{StaticResource AppDataGridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Логин"
                                                                ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                                                Binding="{Binding Login}" />
                                            <DataGridTextColumn Header="Имя"
                                                                ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                                                Binding="{Binding DisplayName}" />
                                            <DataGridTextColumn Header="Роль"
                                                                ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                                                Binding="{Binding Role}" />
                                            <DataGridCheckBoxColumn Header="Active"
                                                                    Binding="{Binding IsActive}" />
                                            <DataGridTextColumn Header="Last Login"
                                                                ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                                                Binding="{Binding LastLoginAtUtc, StringFormat=dd.MM.yyyy HH:mm}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource PanelCardStyle}"
                                Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Редактор пользователя"
                                               Style="{StaticResource CardCaptionTextStyle}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding EditorTitle}"
                                               Style="{StaticResource PageTitleTextStyle}"
                                               FontSize="24" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Margin="0,22,0,0">
                                    <TextBlock Text="Логин"
                                               Style="{StaticResource CardCaptionTextStyle}" />
                                    <TextBox x:Name="LoginTextBox"
                                             Margin="0,6,0,0"
                                             Text="{Binding EditorLogin, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AppTextBoxStyle}" />

                                    <TextBlock Margin="0,16,0,0"
                                               Text="Отображаемое имя"
                                               Style="{StaticResource CardCaptionTextStyle}" />
                                    <TextBox x:Name="DisplayNameTextBox"
                                             Margin="0,6,0,0"
                                             Text="{Binding EditorDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AppTextBoxStyle}" />

                                    <TextBlock Margin="0,16,0,0"
                                               Text="Роль"
                                               Style="{StaticResource CardCaptionTextStyle}" />
                                    <ComboBox Margin="0,6,0,0"
                                              ItemsSource="{Binding RoleOptions}"
                                              SelectedItem="{Binding SelectedRoleOption, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource AppComboBoxStyle}" />

                                    <TextBlock Margin="0,16,0,0"
                                               Text="{Binding PasswordCaption}"
                                               Style="{StaticResource CardCaptionTextStyle}" />
                                    <TextBox Margin="0,6,0,0"
                                             Text="{Binding EditorPassword, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AppTextBoxStyle}" />

                                    <CheckBox Margin="0,16,0,0"
                                              IsChecked="{Binding EditorIsActive, Mode=TwoWay}"
                                              Content="User is active" />

                                    <Border Margin="0,18,0,0"
                                            Padding="16"
                                            Background="#FFF8FAFD"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                        <TextBlock Text="{Binding SelectedRoleDescription}"
                                                   Style="{StaticResource PageDescriptionTextStyle}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Margin="0,22,0,0"
                                            Orientation="Horizontal">
                                    <Button Content="Новый"
                                            Click="NewUserButton_OnClick"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Margin="12,0,0,0"
                                            Content="Сохранить"
                                            Click="SaveUserButton_OnClick"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Margin="12,0,0,0"
                                            Content="Удалить"
                                            Click="DeleteUserButton_OnClick"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
