<Page x:Class="SmartStockAI.App.Views.InboundPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent"
      Title="Приход">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
    <Grid Margin="0,0,0,8">
        <Border Style="{StaticResource PageContainerStyle}">
            <StackPanel>
                <TextBlock Text="DOCUMENT FLOW"
                           Style="{StaticResource SectionEyebrowTextStyle}" />
                <TextBlock Margin="0,10,0,0"
                           Text="Приход"
                           Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Margin="0,8,0,0"
                           Text="Экран будет строиться вокруг одной задачи: быстро провести поступление без лишней визуальной нагрузки."
                           Style="{StaticResource PageDescriptionTextStyle}" />
                <Button Margin="0,18,0,0"
                        HorizontalAlignment="Left"
                        Content="Новая приходная накладная"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <TextBlock Margin="0,28,0,0"
                           Text="Пустой экран прихода."
                           Style="{StaticResource PlaceholderTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
