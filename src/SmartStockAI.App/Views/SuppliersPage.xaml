<Page x:Class="SmartStockAI.App.Views.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent"
      Title="Поставщики">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <Grid Margin="0,0,0,8">
            <Border Style="{StaticResource PageContainerStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="DIRECTORY" Style="{StaticResource SectionEyebrowTextStyle}" />
                        <TextBlock Margin="0,10,0,0" Text="Поставщики" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Margin="0,8,0,0" Text="Справочник поставщиков с базовой карточкой и контактной информацией." Style="{StaticResource PageDescriptionTextStyle}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PanelCardStyle}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock Text="Список поставщиков" Style="{StaticResource CardCaptionTextStyle}" />
                                    <Button DockPanel.Dock="Right" Content="Обновить" Click="ReloadButton_OnClick" Style="{StaticResource SecondaryButtonStyle}" />
                                </DockPanel>
                                <DataGrid x:Name="SuppliersDataGrid"
                                          Grid.Row="1"
                                          Margin="0,18,0,0"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          IsReadOnly="True"
                                          SelectionChanged="SuppliersDataGrid_OnSelectionChanged"
                                          Style="{StaticResource AppDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" />
                                        <DataGridTextColumn Header="Контакт" Binding="{Binding ContactInfo}" />
                                        <DataGridTextColumn Header="Товаров" Binding="{Binding ProductCount}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Карточка поставщика" Style="{StaticResource CardCaptionTextStyle}" />
                                    <TextBlock x:Name="SupplierEditorTitleText" Margin="0,8,0,0" Text="Новый поставщик" Style="{StaticResource PageTitleTextStyle}" FontSize="24" />
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,24,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Название" Style="{StaticResource CardCaptionTextStyle}" />
                                    <TextBox x:Name="SupplierNameTextBox" Grid.Row="1" Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="2" Margin="0,16,0,0" Text="Контактная информация" Style="{StaticResource CardCaptionTextStyle}" />
                                    <TextBox x:Name="SupplierContactTextBox" Grid.Row="3" Margin="0,6,0,0" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                                </Grid>

                                <StackPanel Grid.Row="2"
                                            Margin="0,28,0,0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="Очистить" Click="ResetButton_OnClick" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Margin="12,0,0,0" Content="Сохранить" Click="SaveButton_OnClick" Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
