<Page x:Class="SmartStockAI.App.Views.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent"
      Title="Категории">
    <Grid>
        <Border Style="{StaticResource PageContainerStyle}">
            <StackPanel>
                <TextBlock Text="Категории"
                           Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Margin="0,8,0,0"
                           Text="Заготовка под дерево и список категорий. В первой версии достаточно простого дерева без drag-and-drop."
                           Style="{StaticResource PageDescriptionTextStyle}" />
                <TextBlock Margin="0,28,0,0"
                           Text="Пустой экран категории. Следующий шаг: дерево, форма редактирования и атрибуты."
                           Style="{StaticResource PlaceholderTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
