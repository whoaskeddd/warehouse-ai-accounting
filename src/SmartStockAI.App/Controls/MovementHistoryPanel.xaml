<UserControl x:Class="SmartStockAI.App.Controls.MovementHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Style="{StaticResource PanelCardStyle}"
            Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource CardCaptionTextStyle}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource PageTitleTextStyle}"
                               FontSize="24" />
                </StackPanel>
                <Border Grid.Column="1"
                        Style="{StaticResource PillBadgeStyle}"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding SummaryText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </Grid>

            <TextBox Grid.Row="1"
                     Margin="0,18,0,0"
                     Text="{Binding FilterText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource AppTextBoxStyle}" />

            <DataGrid Grid.Row="2"
                      Margin="0,18,0,0"
                      ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата"
                                        ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                        Binding="{Binding OccurredAt, StringFormat=dd.MM.yyyy HH:mm}" />
                    <DataGridTextColumn Header="Товар"
                                        ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                        Binding="{Binding ProductName}" />
                    <DataGridTextColumn Header="Тип"
                                        ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                        Binding="{Binding MovementType}" />
                    <DataGridTextColumn Header="Документ"
                                        ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                        Binding="{Binding DocumentNumber}" />
                    <DataGridTextColumn Header="Кол-во"
                                        ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                        Binding="{Binding Quantity}" />
                    <DataGridTextColumn Header="Остаток после"
                                        ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                        Binding="{Binding BalanceAfter}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
